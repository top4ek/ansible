entryPoints:
  web:
    address: ":80"
{% if traefik_forwarded_headers_trusted_ips | length > 0 %}
    forwardedHeaders:
      trustedIPs:
{{ traefik_forwarded_headers_trusted_ips | to_nice_yaml | indent(6, true) }}
{% endif %}
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":443"
{% if traefik_forwarded_headers_trusted_ips | length > 0 %}
    forwardedHeaders:
      trustedIPs:
{{ traefik_forwarded_headers_trusted_ips | to_nice_yaml | indent(6, true) }}
{% endif %}
    http3: {}

{% if traefik.ldap | default(false) %}
  ldap:
    address: ":636"

{% endif %}
serversTransport:
  insecureSkipVerify: true

providers:
  docker:
    endpoint: "unix:///run/podman/podman.sock"
    exposedByDefault: false
    watch: true
  file:
    directory: "/etc/traefik/dynamic"
    watch: true

log:
  level: DEBUG
  filePath: /var/log/traefik.log

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ traefik.acme_email }}"
      storage: "/etc/traefik/acme.json"
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"
